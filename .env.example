# Copia este archivo como .env para trabajar sin Docker (XAMPP o php -S).
APP_ENV=local
APP_DEBUG=1
APP_URL=http://localhost:8080
# Local con docker compose (puerto 5433) o la URL de Neon con ?sslmode=require
DATABASE_URL=postgres://vida_salud:vida_salud@localhost:5433/vida_salud

# CU20 · Pasarela de pago: simulada (sin cuentas externas) o stripe (modo prueba)
PASARELA=simulada
# Solo con PASARELA=stripe. Las claves pk_test_… y sk_test_… del panel de Stripe y el secreto
# whsec_… que muestra `stripe listen --forward-to localhost:8080/pagos/webhook`.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
