				{
					"_type": "UMLClass",
					"_id": "AAAAAAGhY/LyO8sF08A=",
					"_parent": {
						"$ref": "AAAAAAGhY/LyOMp5+yA="
					},
					"name": "preferencia_cuenta",
					"stereotype": "table",
					"documentation": "Preferencias de cuenta ya solicitadas en el perfil del paciente.\n\n| Columna | Tipo PostgreSQL | Clave | Admite NULL | Restricción / significado |\n| --- | --- | --- | --- | --- |\n| `usuario_id` | `BIGINT` | PK, FK | No | FK → usuario(id); como máximo una fila por cuenta. |\n| `notificaciones` | `BOOLEAN` | — | No | DEFAULT TRUE; habilita recordatorios futuros. |\n| `mostrar_contacto_al_medico` | `BOOLEAN` | — | No | DEFAULT FALSE; preferencia de privacidad para mostrar teléfono/correo al médico autorizado. |\n\nSe concreta el antiguo campo genérico privacidad en una preferencia verificable: mostrar o no los datos de contacto al médico. El acceso a la información clínica necesaria sigue sujeto a la cita del día y a los permisos; esta preferencia no amplía el conjunto de pacientes accesibles. La preferencia de notificaciones no implementa el envío de recordatorios.",
					"attributes": [
						{
							"_type": "UMLAttribute",
							"_id": "DYCa7bjsWHiDXeaVywptzw==",
							"_parent": {
								"$ref": "AAAAAAGhY/LyO8sF08A="
							},
							"name": "usuario_id",
							"type": "BIGINT",
							"multiplicity": "1",
							"documentation": "PK, FK. NOT NULL. FK → usuario(id); como máximo una fila por cuenta.",
							"stereotype": "PK, FK"
						},
						{
							"_type": "UMLAttribute",
							"_id": "AAAAAAGhY/LyO8sHp6g=",
							"_parent": {
								"$ref": "AAAAAAGhY/LyO8sF08A="
							},
							"name": "notificaciones",
							"type": "BOOLEAN",
							"multiplicity": "1",
							"documentation": "Sin clave. NOT NULL. DEFAULT TRUE; habilita recordatorios futuros."
						},
						{
