							"documentation": "Sin clave. NOT NULL. Una indicación terapéutica por fila, no vacía; incluye pauta cuando sea pertinente."
						},
						{
							"_type": "UMLAttribute",
							"_id": "ZRTnInQzX1qMLUeg4wL74A==",
