							"multiplicity": "1",
							"documentation": "PK. NOT NULL. Identidad autogenerada.",
							"stereotype": "PK"
						},
						{
							"_type": "UMLAttribute",
							"_id": "AeDYDI57UFClRLwriDp5wQ==",
							"_parent": {
								"$ref": "6zvs+07JVty+GTPgydvEVg=="
							},
