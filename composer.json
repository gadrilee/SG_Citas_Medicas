{
    "name": "grupo-seven/vida-salud",
    "description": "Sistema web de gestión de citas médicas para la Clínica Vida Salud (PHP + PostgreSQL)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "VidaSalud\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VidaSalud\\Pruebas\\": "pruebas/"
        }
    },
    "scripts": {
        "pruebas": "phpunit"
    }
}
